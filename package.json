{
  "name": "vanilla-masker-modern",
  "version": "2.0.0",
  "description": "VanillaMasker fork with modern input handling, tested formatters and UMD/CommonJS/ESM builds.",
  "repository": { "type": "git", "url": "https://github.com/wellington043/vanilla-masker.git" },
  "homepage": "https://wellington043.github.io/vanilla-masker/",
  "bugs": { "url": "https://github.com/wellington043/vanilla-masker/issues" },
  "license": "MIT",
  "keywords": ["mask", "input", "vanilla-masker", "currency", "formatter"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "main": "dist/vmask.cjs",
  "module": "dist/vmask.mjs",
  "browser": "dist/vmask.js",
  "exports": {
    ".": {
      "import": "./dist/vmask.mjs",
      "require": "./dist/vmask.cjs"
    },
    "./lib/vanilla-masker.js": "./lib/vanilla-masker.js",
    "./build/vanilla-masker.min.js": "./build/vanilla-masker.min.js",
    "./dist/*": "./dist/*"
  },
  "files": ["dist", "lib", "build", "src", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:pages": "npm run build && node scripts/build-pages.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:browser": "npm run build && node tests/browser.cjs",
    "check": "npm test && npm run test:browser",
    "benchmark": "node scripts/benchmark.cjs",
    "browsers:install": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  }
}
